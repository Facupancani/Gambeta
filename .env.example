# Copy this file to `.env` and fill in real values. See README.md "Setup" for step-by-step instructions.

# TiDB Cloud Serverless connection string (Connect → Prisma).
DATABASE_URL="mysql://user:password@host:4000/gambeta"

# First admin user, created by `npm run db:seed`.
ADMIN_EMAIL="admin@gambeta.com"
ADMIN_PASSWORD="change-me"

# Random 32-byte secret used to sign the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""

# Cloudinary dashboard → Cloud name, and an "unsigned" upload preset you create.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# WhatsApp number for checkout, international format, digits only (no "+", no spaces).
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Optional: powers the "Generar borrador" AI description helper in the admin
# product form. Without it, that button just shows an error — everything
# else works fine. Get a key at https://console.anthropic.com (no NEXT_PUBLIC_
# prefix on purpose: this one must never reach the browser).
ANTHROPIC_API_KEY=""

# Absolute site URL, used for sitemap.xml / robots.txt (e.g. https://gambeta.vercel.app).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
